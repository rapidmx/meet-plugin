{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "rootDir": "apps",
        "outDir": "dist/apps",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "sourceMap": false,
        "declaration": true,
        "allowSyntheticDefaultImports": true,
        "noImplicitAny": false,
        "types": ["vite/client"]
    },
    "include": ["apps"]
}
